{
  "name": "agent-neuron-viz",
  "version": "0.0.0",
  "private": true,
  "description": "A 3D view of agent-neuron networks, driven by the Rust engine over MCP.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
