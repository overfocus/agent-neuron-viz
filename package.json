    "check": "tsc --noEmit && vitest run && vite build",
    "pin": "node bin/pin.mjs"
  },
  "dependencies": {
    "d3-force-3d": "3.0.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
